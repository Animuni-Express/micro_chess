{
  "name": "micro_chess",
  "version": "1.0.0",
  "description": "Lightweight chess PWA — over-the-board & vs Stockfish",
  "scripts": {
    "build": "bun run build:main && bun run build:kindle && node scripts/prepare-publish.mjs",
    "build:main": "esbuild ./src/main.jsx --bundle --outfile=public/bundle.js --format=iife --target=es2017 --jsx=automatic --jsx-import-source=preact --minify",
    "build:kindle": "node scripts/build-kindle.mjs",
    "dev": "esbuild ./src/main.jsx --bundle --outfile=public/bundle.js --format=iife --target=es2017 --jsx=automatic --jsx-import-source=preact --watch --servedir=.",
    "start": "bun run build && serve .",
    "test": "node --test tests/*.test.js",
    "dev:netlify": "serve . -l 8080",
    "test:multiplayer": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "netlify": "node node_modules/netlify-cli/bin/run.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@netlify/database-dev": "^1.0.1",
    "@types/jest": "^29.5.0",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "netlify-cli": "^27.14.2",
    "playwright": "^1.61.1",
    "serve": "^14.2.6"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "chess.js": "^0.13.4",
    "preact": "^10.29.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ]
}
