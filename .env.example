# Micro Chess — server-side secrets template.
#
# Copy to .env and fill in real values. `.env` is gitignored: never commit it.
# These values are read by the `lichess` Supabase Edge Function, so after editing
# .env you must push them to Supabase:
#
#     bash scripts/set-lichess-secrets.sh
#
# (equivalently: supabase secrets set --env-file .env --project-ref <ref>)

# ---------------------------------------------------------------------------
# Lichess relay tokens (required for "Play a Lichess player")
# ---------------------------------------------------------------------------
# Lichess personal access tokens, created at
# https://lichess.org/account/oauth/token/create with the "board:play" scope
# (Play games with the board API). Comma-separated: each token is one Lichess
# account, and each account can host exactly one relayed game at a time, so the
# number of tokens is the number of simultaneous Lichess games Micro Chess can
# broker. Start with one; add more to raise capacity.
LICHESS_TOKENS=lip_<paste-your-token-here>

# Single-token alias, honoured if LICHESS_TOKENS is unset.
# LICHESS_API_TOKEN=lip_<paste-your-token-here>

# ---------------------------------------------------------------------------
# Optional relay tuning (defaults shown)
# ---------------------------------------------------------------------------
# Clock for the seeks Micro Chess posts to the Lichess pool: minutes+increment.
# LICHESS_SEEK_INCREMENT=0
# How long one find_opponent call holds a seek open before returning
# "still searching" so the browser can call again (milliseconds, max 55000).
# LICHESS_SEEK_HOLD_MS=20000
# How long a get_game long-poll waits for the opponent to move (milliseconds).
# LICHESS_STREAM_HOLD_MS=20000
# Minutes of client silence after which an abandoned relayed game is resigned
# and its seat handed back to the pool.
# LICHESS_SEAT_LEASE_MINUTES=10

# ---------------------------------------------------------------------------
# Supabase (only needed by the deploy scripts; Edge Functions get these for free)
# ---------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=ncsqidwsimmdbkoiidlz
